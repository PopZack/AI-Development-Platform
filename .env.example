# ============ 应用 ============
APP_NAME=AI Dev Team
APP_ENV=local
DEBUG=true

# ============ 数据库 ============
# Stage 1 使用 SQLite（异步驱动 aiosqlite）
DATABASE_URL=sqlite+aiosqlite:///./data/ai_dev_team.db
SQL_ECHO=false

# ============ JWT ============
# 密钥必须 >= 32 字节（RFC 7518 对 HS256 的要求），否则每次签发/校验都会抛
# InsecureKeyLengthWarning。上生产前换成自己的随机串。
# APP_ENV=prod 时如果还是默认值或长度不足，应用会直接启动失败。
JWT_SECRET_KEY=change-me-before-any-real-use-32bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============ LLM Provider（Stage 3 生效）============
# LLM_PROVIDER 决定装配哪个 Provider 实现，当前预留：ark（火山方舟）
# 换成其他供应商时只需新增 Provider 实现并改这里，Agent 层不动
LLM_PROVIDER=ark
# ⚠️ 火山方舟有两套端点，配错的表现是 401，而且报错只说「密钥无效」不提示是端点错：
#    平台端点   /api/v3            模型名带日期后缀（deepseek-v4-flash-260425），
#                                   或自建接入点的 ep-xxxx
#    Agent Plan /api/plan/v3       模型名用短名（deepseek-v4-flash），
#                                   且专属 Key 与平台 Key 不是同一个
#    （另有 /api/coding/v3，是另一条 plan 路径，key 权限范围与 plan 不同）
#    三者必须配成同一套：LLM_BASE_URL / LLM_API_KEY / LLM_MODEL
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# ⚠️ Agent 一次调用实测 20~40 秒（PRD / 架构这类长输出）。
#    60s 会超时（504 TIMEOUT），需求会被标成 FAILED。
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# ============ 本地工作区（Stage 4 生效）============
# Tool Gateway 的授权根目录，所有文件工具路径必须落在它内部
WORKSPACE_ROOT=./workspace

# ============ 限流（Stage 5：多人部署的前置条件）============
# 每个用户都能触发会真实调模型的操作（一次 20~40 秒 + 花 token），
# 没有限流的话一个手滑的循环就能把额度和机器一起打满。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_LLM_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=20
# ⚠️ 挂在 nginx / 网关后面时必须开启，否则所有请求都算在代理的 IP 上
#    （等于把全站限成一份额度，第一个用户就把额度用光）。
#    只在前置代理可信时开 —— 否则客户端可以伪造 X-Forwarded-For 绕过限流。
RATE_LIMIT_TRUST_PROXY=false
# Redis 不可用时放行还是拒绝。默认放行（fail-open）
RATE_LIMIT_FAIL_OPEN=true

# ============ Redis（可选，多 worker 部署必需）============
# 留空 = 单进程模式：限流走内存、SSE 事件走进程内广播，功能完整。
# ⚠️ 多 worker（uvicorn --workers N / gunicorn）时必须配上，否则：
#    1) 每个 worker 各算各的限额，实际限额被乘以 worker 数
#    2) SSE 事件只在产生事件的那个 worker 上可见，前端会「有时收到有时收不到」
# 示例：redis://:password@127.0.0.1:6379/0
REDIS_URL=
# SSE 心跳间隔（秒）。nginx 默认 60s 会掐掉长时间无数据的连接，所以要小于它
SSE_HEARTBEAT_SECONDS=15
# ============ Redis 硬依赖开关 ============
# true 时：没配 REDIS_URL、redis 包没装、ping 不通，三种情况都**拒绝启动**
# （而不是降级告警）。给多人部署用；本地单进程开发保持 false
# REQUIRE_REDIS=false

