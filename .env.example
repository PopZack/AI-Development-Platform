# ============ 应用 ============
APP_NAME=AI Dev Team
APP_ENV=local
DEBUG=true

# ============ 数据库 ============
# Stage 1 使用 SQLite（异步驱动 aiosqlite）
DATABASE_URL=sqlite+aiosqlite:///./data/ai_dev_team.db
SQL_ECHO=false

# ============ JWT ============
# 密钥必须 >= 32 字节（RFC 7518 对 HS256 的要求），否则每次签发/校验都会抛
# InsecureKeyLengthWarning。上生产前换成自己的随机串。
# APP_ENV=prod 时如果还是默认值或长度不足，应用会直接启动失败。
JWT_SECRET_KEY=change-me-before-any-real-use-32bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============ LLM Provider（Stage 3 生效）============
# LLM_PROVIDER 决定装配哪个 Provider 实现，当前预留：ark（火山方舟）
# 换成其他供应商时只需新增 Provider 实现并改这里，Agent 层不动
LLM_PROVIDER=ark
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ============ 本地工作区（Stage 4 生效）============
# Tool Gateway 的授权根目录，所有文件工具路径必须落在它内部
WORKSPACE_ROOT=./workspace
